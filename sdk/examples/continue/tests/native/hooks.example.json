{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_continue.integration",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_continue.integration",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_continue.integration",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_continue.integration",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_continue.integration",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
