{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "watcher-github-copilot-cli observe --config /path/printed/by/setup/config.json --record-only",
        "timeoutSec": 50
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "watcher-github-copilot-cli enforce --config /path/printed/by/setup/config.json",
        "timeoutSec": 480
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "watcher-github-copilot-cli observe --config /path/printed/by/setup/config.json --record-only",
        "timeoutSec": 50
      }
    ]
  }
}
