{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_goose.integration --record-only",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WATCHER_PYTHON__ -m watcher_goose.pre_tool",
            "timeout": 480,
            "on_failure": "block"
          }
        ]
      }
    ]
  }
}
